# Copy to .env and fill in. .env is gitignored — never commit real values.

# Hedera testnet operator (treasury account for the QUOTA token)
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=302e...

# Layer 2 (Sepolia): same wallet acts as both deployer and the
# QuotaAnchor relayer (the only address allowed to call it).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_DEPLOYER_KEY=0x...

# Free key from https://etherscan.io/apis -- only needed if Hardhat's
# built-in verify actually requires one for Sepolia (untested yet).
ETHERSCAN_API_KEY=

# Added when Layer 3 (ENS) / subgraph work starts:
# GRAPH_STUDIO_DEPLOY_KEY=
